{
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": [
    "src/ros2bag_tools/rosbag2_tools",
    "src/ros2bag_tools/ros2bag_tools",
  ],
  "cSpell.words": [
    "autopep",
    "cmake",
    "coveragepy",
    "cppcheck",
    "cpplint",
    "DCMAKE",
    "deque",
    "devcontainer",
    "devel",
    "ints",
    "metadatas",
    "nanosec",
    "noqa",
    "pycache",
    "pylint",
    "pytest",
    "rclcpp",
    "rclpy",
    "rcutils",
    "repos",
    "rosbag",
    "rosdep",
    "rosdistro",
    "rosidl",
    "rostest",
    "RTPS",
    "uncrustify",
    "vcstool",
    "vscrc",
    "Wextra",
    "Wpedantic",
    "xmllint",
    "zcom"
  ],
  "cSpell.allowCompoundWords": true,
  "cSpell.ignorePaths": [
    "**/package-lock.json",
    "**/node_modules/**",
    "**/vscode-extension/**",
    "**/.git/**",
    ".vscode",
    ".vscode-insiders",
    ".devcontainer/devcontainer.json"
  ],
  "search.exclude": {
    "**/node_modules": true,
    "**/bower_components": true,
    "**/*.code-search": true,
    "**/build": true,
    "**/install": true,
    "**/log": true
  },
  "editor.formatOnSave": false,
  "editor.renderWhitespace": "all",
  "editor.rulers": [
    99
  ],
  "editor.codeActionsOnSave": {
    "source.organizeImports": "never"
  },
  "terminal.integrated.profiles.linux": {
    "ros_ws_bash": {
      "path": "bash",
      "icon": "terminal-bash",
      "args": ["--rcfile", "${workspaceFolder}/.bashrc"],
      "env": {
        "WS_HISTFILE": "${workspaceFolder}/.bash_history"
      }
    },
    "ros_ws_zsh": {
        "path": "zsh",
        "icon": "console",
        "env": {
            "OLD_ZDOTDIR": "${env:ZDOTDIR}",
            "ZDOTDIR": "${workspaceFolder}",
            "WS_HISTFILE": "${workspaceFolder}/.zsh_history"
        }
    }
  },
  "terminal.integrated.defaultProfile.linux": "ros_ws_bash",
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff"
  },
  "flake8.cwd": "${fileDirname}",
}
